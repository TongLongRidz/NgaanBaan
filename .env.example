# PostgreSQL Database Configuration
POSTGRES_USER=ngaanbaan_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ngaanbaan_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB Configuration (Audit Logs & Chat History)
MONGO_INITDB_ROOT_USERNAME=ngaanbaan_mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ngaanbaan_logs
MONGO_URI=mongodb://ngaanbaan_mongo_user:your_mongo_password_here@localhost:27017/ngaanbaan_logs?authSource=admin

# Backend Server Configuration
PORT=8080
GIN_MODE=debug
# Run command: `openssl rand -hex 64` to generate a 256-bit secret key
JWT_SECRET=change_this_to_a_secure_random_string

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Database Connection URL (for Go Backend)
DATABASE_URL=postgres://ngaanbaan_user:your_postgres_password_here@localhost:5432/ngaanbaan_db?sslmode=disable

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

# SMTP Configuration (Send real emails to ANY address without buying a domain!)
# For Gmail: Use your Gmail address and 16-digit App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NgaanBaan

# Resend Email Configuration (Alternative API)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=NgaanBaan <onboarding@resend.dev>
# APP_URL=http://localhost:3000
