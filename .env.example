8# PostgreSQL Database Configuration
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=kanban_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB Configuration (Audit Logs & Chat History)
MONGO_INITDB_ROOT_USERNAME=kanban_mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=kanban_logs
MONGO_URI=mongodb://kanban_mongo_user:your_mongo_password_here@localhost:27017/kanban_logs?authSource=admin

# Backend Server Configuration
PORT=8080
GIN_MODE=debug
JWT_SECRET=change_this_to_a_secure_random_string

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Database Connection URL (for Go Backend)
DATABASE_URL=postgres://kanban_user:your_postgres_password_here@localhost:5432/kanban_db?sslmode=disable

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
